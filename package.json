{
  "name": "rasan",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "رسن — تطبيق دردشة مشفّر نهاية-ل-نهاية (client + web + tests)",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "for f in web/*.js tests/*.js vitest.config.js; do node --check \"$f\" || exit 1; done && echo 'lint: ok'",
    "verify": "npm run lint && npm test"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "bcryptjs": "^2.4.3",
    "express": "^4.22.3",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "vitest": "^5.0.5"
  }
}
